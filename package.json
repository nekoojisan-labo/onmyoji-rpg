{
  "name": "onmyoji-rpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "京音都・陰陽師アクションRPG Phase0 技術プロト",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "screenshot": "node tools/screenshot.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/three": "^0.171.0",
    "@vitest/coverage-v8": "^2.1.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
